{
  "name": "decky-spotify",
  "version": "0.4.20",
  "description": "Compact Decky Spotify player with managed librespot and phone QR sign-in.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "rollup -c",
    "build:preview": "vite build",
    "test": "vitest run",
    "package": "pnpm build && node scripts/package.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:backend && pnpm build && pnpm build:preview",
    "test:backend": "python3 -m unittest discover -s tests/backend -v",
    "package:frontend": "rollup -c --environment FRONTEND_ONLY:true && node scripts/package.mjs --frontend-only"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "i18next": "^25.6.0",
    "qrcode-generator": "2.0.4",
    "react-i18next": "^16.2.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.12.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "jsqr": "1.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rollup": "^4.53.3",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
